              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "Opaque cursor, bound to authenticated owner, collection and account where applicable. Invalid, mismatched or expired cursor returns 400 INVALID_CURSOR."
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "AccountNumber": {
        "type": "string",
        "minLength": 1,
        "description": "Opaque service-assigned account identifier. Preserve leading zeros; URL-encode as a path segment. Never recycled."
      },
      "AccountCreate": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
